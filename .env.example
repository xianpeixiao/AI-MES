# 数据库（可选，默认 localhost / root / AI-MES）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=AI-MES
DB_USER=root
DB_PASSWORD=root

# Redis（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# 后端端口（可选）
SERVER_PORT=8080

# 本地知识库（可选，默认自动探测项目根 docs/knowledge-base）
KNOWLEDGE_BASE_DIR=
KNOWLEDGE_TOP_K=5

# Coze / DeepSeek 共用提示词（可选，默认自动读取 docs/ 下 txt）
COZE_BOT_PERSONA_PATH=
SCHEDULING_SYSTEM_PROMPT_PATH=
SCHEDULING_USER_PROMPT_PATH=

# Coze（可选）
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_WORKFLOW_ID=
COZE_API_URL=https://api.coze.cn/v3

# DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 前端开发（可选）
VITE_API_BASE_URL=/api
